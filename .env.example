# Copy to .env for local development. docker compose supplies its own values.

# ---------------------------------------------------------------- database
# Generate every secret in this file with URL-safe base64 — plain base64 emits
# + and /, and a / inside a connection string silently truncates the host:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
DATABASE_URL=postgres://oobee:CHANGE-ME@localhost:5432/oobeebets
DB_POOL_MAX=10

# --------------------------------------------------------------- seeding
# `npm run db:seed` DELETES every user, slate, pick and audit entry, then
# writes one empty admin account. It creates no slates and no picks: a product
# whose claim is that its record is real does not ship a fabricated one, so
# anything needing a board builds its own (scripts/fixtures.mjs). It refuses to
# run unless this is exactly 1, and refuses outright when NODE_ENV=production.
# Leave it 0 anywhere that holds real data.
ALLOW_DESTRUCTIVE_SEED=0

# Who the seed creates: one admin, and nobody else. Set these to bootstrap a
# different first admin without editing the script; every later admin is
# promoted from /admin/users by an existing one, and every tester arrives by
# invite. The test suites create and drop their own plain user, so nothing here
# leaves a standing login behind.
# SEED_PASSWORD left empty means the seed generates a random one and prints it,
# so no deployment can end up with a password this file already knows.
SEED_ADMIN_EMAIL=nemanjas@oobeebets.com
SEED_PASSWORD=

# Container-only, and off by default: docker/entrypoint.sh seeds only when this
# is exactly 1. It used to reseed on every start, which meant every deploy wiped
# the accounts people had signed up with. Set it to 1 for the one deploy that
# should reset the database, then set it back.
RUN_SEED=0

# ------------------------------------------------------------------ email
# Resend does two jobs here, and both of them are required rather than
# best-effort:
#
#   1. Invitations. The only delivery path a new account has — an invite that
#      silently no-ops leaves an admin believing someone was invited when
#      nobody was (see lib/email/resend-client.ts).
#   2. The mailing list at /soon. Resend's contact book *is* the list; there is
#      no waitlist table and no local mirror, so without a key there is nowhere
#      to put a subscriber and signup fails outright (see lib/newsletter.ts).
#
#   RESEND_API_KEY   from https://resend.com/api-keys
#   EMAIL_FROM       "oobee bets <noreply@yourdomain.com>" — the domain must be
#                     verified in Resend, or sends are rejected.
RESEND_API_KEY=
EMAIL_FROM=

# Optional, and mailing-list only. Set it and every new contact joins this
# segment, which is how the pre-launch list stays separable from anything added
# after launch. Leave it blank and contacts land in the account-wide book.
# Create one at https://resend.com/segments
RESEND_SEGMENT_ID=

# Optional. EMAIL_REPLY_TO gives a noreply sender somewhere for replies to land
# — an invite is the one mail people answer. EMAIL_IDEMPOTENCY_PREFIX namespaces
# Resend idempotency keys, which matters where two deployments share one API
# key: without it, beta and production would be deduplicating against each
# other's sends. Defaults to "oobeebets".
EMAIL_REPLY_TO=
EMAIL_IDEMPOTENCY_PREFIX=

# ---------------------------------------------------------------- deploy
# Not read by the app: the HMAC key shared by the GitHub Actions deploy job and
# the webhook receiver on the server. Kept here so it lives in one gitignored
# place, and must match the WEBHOOK_SECRET repo secret in GitHub.
WEBHOOK_SECRET=

# ------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Betting-day boundary is 04:00 in this zone (see src/lib/slate-date.ts).
NEXT_PUBLIC_SLATE_TZ=America/New_York

# -------------------------------------------------------------- beta gate
# Set on the beta deployment only. Any non-empty value puts a password prompt
# in front of every page, and leaving it unset — main, production — removes the
# gate entirely rather than leaving an open one.
#
# It is also the key the gate's cookies are signed with, so changing it signs
# everyone out. Generate one the same way as every other secret here:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
BETA_GATE_PASSWORD=

# --------------------------------------------------------------- postgres
# Used by docker compose only.
POSTGRES_USER=oobee
# Read only when the pgdata volume is first created. Rotating it afterwards
# needs an ALTER USER against the running container too, or DATABASE_URL and
# the database disagree and every connection fails.
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=oobeebets
POSTGRES_PORT=5432
APP_PORT=3000
