# Copy to .env for local development. docker compose supplies its own values.

# ---------------------------------------------------------------- database
# Generate every secret in this file with URL-safe base64 — plain base64 emits
# + and /, and a / inside a connection string silently truncates the host:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
DATABASE_URL=postgres://oobee:CHANGE-ME@localhost:5432/oobeebets
DB_POOL_MAX=10

# --------------------------------------------------------------- seeding
# `npm run db:seed` DELETES every user, slate, pick and audit entry before it
# writes demo data. It refuses to run unless this is exactly 1, and refuses
# outright when NODE_ENV=production. Leave it 0 anywhere that holds real data.
ALLOW_DESTRUCTIVE_SEED=0

# Container-only. When 1 (the default), docker/entrypoint.sh reseeds on every
# start — so every deploy wipes the database. The entrypoint overrides both
# guards above to do it, so this flag alone decides. Set 0 wherever the data
# matters.
RUN_SEED=0

# ------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Betting-day boundary is 04:00 in this zone (see src/lib/slate-date.ts).
NEXT_PUBLIC_SLATE_TZ=America/New_York

# ---------------------------------------------------------------- billing
# mock  — POC: subscriptions are written locally, no payment taken
# stripe — production: requires the keys below and a webhook endpoint
BILLING_PROVIDER=mock

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Price object per tier. Raise prices by creating NEW prices and swapping
# these ids — never by editing a Price in place, or existing subscribers get
# re-priced and the grandfathering promise breaks.
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# --------------------------------------------------------------- postgres
# Used by docker compose only.
POSTGRES_USER=oobee
# Read only when the pgdata volume is first created. Rotating it afterwards
# needs an ALTER USER against the running container too, or DATABASE_URL and
# the database disagree and every connection fails.
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=oobeebets
POSTGRES_PORT=5432
APP_PORT=3000
