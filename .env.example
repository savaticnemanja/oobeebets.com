# Copy to .env for local development. docker compose supplies its own values.

# ---------------------------------------------------------------- database
# Generate every secret in this file with URL-safe base64 — plain base64 emits
# + and /, and a / inside a connection string silently truncates the host:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
DATABASE_URL=postgres://oobee:CHANGE-ME@localhost:5432/oobeebets
DB_POOL_MAX=10

# ------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------ email
# Resend. REQUIRED — this is no longer only about delivery. Resend's contact
# book *is* the mailing list (there is no waitlist table any more), so without
# a key there is nowhere to put a subscriber and signup fails outright rather
# than degrading. Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain verified in Resend, or delivery fails. The default is
# Resend's shared sandbox sender, which only delivers to your own account.
EMAIL_FROM="oobee bets <hello@oobeebets.com>"
# Optional. Set it and every new contact joins this segment, which is how the
# pre-launch list stays separable from anything added after launch. Leave it
# blank and contacts land in the account-wide book, which is fine while the
# pre-launch list is the only one. Create one at https://resend.com/segments
RESEND_SEGMENT_ID=

# --------------------------------------------------------------- postgres
# Used by docker compose only.
POSTGRES_USER=oobee
# Read only when the pgdata volume is first created. Rotating it afterwards
# needs an ALTER USER against the running container too, or DATABASE_URL and
# the database disagree and every connection fails.
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=oobeebets
POSTGRES_PORT=5432
APP_PORT=3000
